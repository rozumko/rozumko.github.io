DATABASE_URL=postgresql://user:password@host:5432/dbname
PORT=3000
NODE_ENV=development
SUPABASE_URL=https://<project-id>.supabase.co
ATTEMPT_SECRET=<random-hex-64-chars>   # node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_STORE=memory

# Optional admin-triggered static content publication. Use a fine-grained token
# limited to this repository with Actions: write, never a broad classic token.
CONTENT_PUBLISH_GITHUB_TOKEN=<fine-grained-actions-write-token>
CONTENT_PUBLISH_GITHUB_REPOSITORY=<owner/repository>
CONTENT_PUBLISH_CALLBACK_SECRET=<random-hex-64-chars>

# Reserved for future shared rate limiting when running multiple backend processes.
REDIS_URL=redis://localhost:6379
