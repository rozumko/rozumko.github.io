    {
      "id": "g2-m2-l8-b05",
      "type": "explanation",
      "audience": { "teacher": true, "student": true },
      "views": { "document": true, "presentation": true, "remote": false },
      "modality": "teacher-led",
      "estimatedMinutes": 7,
