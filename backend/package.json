{
  "name": "megarozum-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:migrate:check": "tsx src/db/check-migrations.ts",
    "db:migrate:check:prod": "node dist/db/check-migrations.js",
    "db:seed": "tsx src/db/seed.ts",
    "export:questions": "tsx scripts/export-practice-questions.ts",
    "export:lessons": "tsx scripts/export-lessons.ts",
    "export:path": "tsx scripts/export-path.ts",
    "export:content-packs": "tsx scripts/export-content-packs.ts",
    "export:content-manifest": "tsx scripts/export-content-manifest.ts",
    "export:all-content": "npm run db:migrate:check && npm run export:questions && npm run export:lessons && npm run export:path && npm run export:content-packs && npm run export:content-manifest",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^11.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "jose": "^6.2.3",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
