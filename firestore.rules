rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAnon() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isTeacher() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    // --- users ---
    // Кожен читає і пише лише свій профіль. Адмін читає всі.
    match /users/{userId} {
      allow read:   if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.role == 'teacher'
                    && request.resource.data.keys().hasAll(['role','email','createdAt']);
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    // --- students ---
    // Вчитель створює тільки своїх учнів (teacherUid == uid).
    // Будь-який авторизований читає (учень валідує код).
    // Оновлює тільки власний вчитель або адмін.
    match /students/{studentCode} {
      // Вчитель читає свій клас (list), анонімний учень читає тільки конкретний документ (get)
      allow get:    if isSignedIn();
      allow list:   if isAdmin() || isTeacher();
      allow create: if isTeacher()
                    && request.resource.data.teacherUid == request.auth.uid
                    && request.resource.data.code == studentCode
                    && request.resource.data.keys().hasAll([
                         'code','grade','classId','teacherUid','isActive','createdAt'
                       ]);
      allow update: if isAdmin()
                    || (isTeacher() && resource.data.teacherUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // --- olympiad_events ---
    // Будь-який авторизований читає (учень шукає активну подію).
    // Пише тільки адмін.
    match /olympiad_events/{eventId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // --- olympiad_sessions ---
    // Анонімний учень створює сесію. Оновлює тільки ту де lastAnonymousUid == uid.
    // Вчитель і адмін читають всі.
    match /olympiad_sessions/{sessionId} {
      allow read: if isAdmin() || isTeacher() || isAnon();
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasAll([
                         'eventId','studentCode','teacherUid','grade',
                         'startedAt','status','attemptCount','lastAnonymousUid'
                       ])
                    && request.resource.data.status == 'started';
      allow update: if isAdmin()
                    || (isAnon()
                        && resource.data.lastAnonymousUid == request.auth.uid
                        && request.resource.data.status in ['completed','blocked']
                        && request.resource.data.lastAnonymousUid == resource.data.lastAnonymousUid);
      allow delete: if isAdmin();
    }

    // --- olympiad_questions ---
    // Авторизовані (включно анонімних учнів) читають. Пише тільки адмін.
    match /olympiad_questions/{questionId} {
      allow read:  if isSignedIn();
      allow write: if isAdmin();
    }

    // --- olympiad_results ---
    // Учень створює один раз — не може редагувати після запису.
    // score не може перевищувати totalQuestions.
    // Вчитель читає тільки свої результати.
    match /olympiad_results/{resultId} {
      allow read: if isAdmin()
                  || (isTeacher() && resource.data.teacherUid == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.keys().hasAll([
                         'eventId','studentCode','teacherUid','grade',
                         'score','totalQuestions','mode','completedAt','sessionId'
                       ])
                    && request.resource.data.mode == 'olympiad'
                    && request.resource.data.score is int
                    && request.resource.data.score >= 0
                    && request.resource.data.score <= request.resource.data.totalQuestions
                    && request.resource.data.totalQuestions is int
                    && request.resource.data.totalQuestions > 0
                    && exists(/databases/$(database)/documents/olympiad_sessions/$(request.resource.data.sessionId))
                    && get(/databases/$(database)/documents/olympiad_sessions/$(request.resource.data.sessionId)).data.status == 'completed'
                    && get(/databases/$(database)/documents/olympiad_sessions/$(request.resource.data.sessionId)).data.studentCode == request.resource.data.studentCode;
      allow update, delete: if isAdmin();
    }
  }
}
