# ── Сирі ілюстрації маскота/аватарів (джерело, ~1.2МБ кожна) ──────────────
# Оптимізовані версії у public/ (avatars/, mascot-*.png, images/half/) — вони й деплояться.
# Перегенерувати: npm run optimize:images
# Прив'язано до кореня (/), щоб не ловити public/images/ — воно деплоїться.
/images/

# ── Бренд-кіт (джерело: лого, фавікони, badge). Потрібні файли скопійовані
# в public/ (favicon.svg/ico, apple-touch-icon.png, rozumko-logo.svg) — вони й деплояться.
rozumko_brand_assets/

# ── Джерельні матеріали (PDF-фреймворки тощо — не для деплою) ─────────────
*.pdf
# Референсні навчальні документи (Cambridge-програма .docx тощо) — лише локально.
/documents/
*.load-codes.local.txt
